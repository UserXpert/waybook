{
  "name": "@waybook/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WAYBOOK_NEXT_DIST_DIR=.next-dev next dev --port 3333",
    "prebuild": "npm run build --workspace=@thebookingkit/core && npm run build --workspace=@thebookingkit/db && npm run build --workspace=@thebookingkit/server",
    "build": "next build",
    "start": "next start --port 3333",
    "test": "tsx --test src/lib/waybook/*.test.ts",
    "e2e": "playwright test --config e2e/waybook.config.ts",
    "e2e:ui": "playwright test --config e2e/waybook.config.ts --ui",
    "e2e:legacy": "playwright test --config e2e/playwright.config.ts",
    "e2e:db": "E2E_WITH_DB=1 playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@thebookingkit/core": "*",
    "@thebookingkit/db": "*",
    "@thebookingkit/server": "*",
    "better-auth": "^1.7.17",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.69.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
