{
  "name": "waybook",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "waybook:db:start": "bash scripts/waybook-local-db.sh",
    "waybook:db:migrate": "tsx scripts/migrate-waybook.ts",
    "waybook:db:seed": "tsx scripts/seed-waybook.ts",
    "waybook:test:pooled": "tsx scripts/verify-waybook-pooled-availability.ts",
    "waybook:test:hold-lifecycle": "tsx scripts/verify-waybook-hold-race.mts",
    "waybook:test:booking-sales": "tsx scripts/verify-waybook-booking-sales.ts",
    "waybook:test:booking-product-addons": "tsx scripts/verify-waybook-booking-product-addons.ts",
    "waybook:test:booking-package-redemption": "tsx scripts/verify-waybook-booking-package-redemption.ts",
    "waybook:build": "npm --prefix apps/demo run build",
    "waybook:release:check": "node scripts/check-waybook-release.mjs",
    "waybook:db:status": "tsx scripts/check-waybook-schema.mts",
    "waybook:dev": "npm run waybook:db:status -- --local --allow-pending && npm run waybook:db:migrate -- --local && npm run dev --workspace=@waybook/app"
  },
  "devDependencies": {
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "sharp": "^0.35.5"
  }
}
