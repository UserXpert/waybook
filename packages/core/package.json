{
  "name": "@waybook/core",
  "version": "0.5.0",
  "description": "Headless scheduling engine: slot computation, RRULE expansion, team assignment, resource & capacity booking, recurring bookings, walk-ins, and kiosk mode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UserXpert/waybook.git",
    "directory": "packages/core"
  },
  "keywords": [
    "waybook",
    "booking",
    "scheduling",
    "availability",
    "slots",
    "rrule",
    "timezone"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "date-fns": "^3.6.0 || ^4.0.0",
    "date-fns-tz": "^3.2.0",
    "rrule": "^2.8.0"
  },
  "devDependencies": {
    "@waybook/db": "*",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true
}
