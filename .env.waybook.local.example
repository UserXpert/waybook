# Local-only Waybook development databases. Copy these values into .env.local
# when running the Waybook app; never use a client or production connection here.
WAYBOOK_CONTROL_DATABASE_URL=postgresql://waybook@127.0.0.1:5440/waybook_control
WAYBOOK_NORDIC_STUDIO_DATABASE_URL=postgresql://waybook@127.0.0.1:5440/waybook_nordic_studio
WAYBOOK_COPENHAGEN_PHYSIO_DATABASE_URL=postgresql://waybook@127.0.0.1:5440/waybook_copenhagen_physio
WAYBOOK_GIFT_CARD_CODE_SECRET=replace-with-a-long-random-secret-before-production
